# App
ENVIRONMENT=development
DEBUG=true

# Security - generate a strong random value for production, e.g.: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Postgres in production/docker, SQLite works fine for quick local runs)
DATABASE_URL=postgresql://saas_user:saas_password@db:5432/saas_backend

# CORS - comma-separated list is NOT supported here; edit app/core/config.py CORS_ORIGINS default,
# or set as a JSON array string if you prefer, e.g. '["http://localhost:3000"]'
CORS_ORIGINS=["http://localhost:3000"]

# Stripe (use test-mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxx
FRONTEND_SUCCESS_URL=http://localhost:3000/billing/success
FRONTEND_CANCEL_URL=http://localhost:3000/billing/cancel
